<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap5 rescap">
  <Identity Name="WifiGuardian.Dev" Publisher="CN=WifiGuardian.Dev" Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>WiFi Guardian</DisplayName>
    <PublisherDisplayName>WiFi Guardian (local)</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.16299.0" MaxVersionTested="10.0.22621.0" />
  </Dependencies>
  <Resources>
    <Resource Language="es-ES" />
  </Resources>
  <Applications>
    <Application Id="WifiGuardian" Executable="WifiGuardian.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements DisplayName="WiFi Guardian"
                          Description="Monitor de Wi-Fi, Internet y punto de acceso móvil"
                          BackgroundColor="#173F34"
                          Square150x150Logo="Assets\Square150x150Logo.png"
                          Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap5:Extension Category="windows.startupTask" Executable="WifiGuardian.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="WifiGuardianStartup" Enabled="false" DisplayName="WiFi Guardian" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <DeviceCapability Name="wiFiControl" />
  </Capabilities>
</Package>
