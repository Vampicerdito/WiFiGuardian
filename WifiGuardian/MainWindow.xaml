<Window x:Class="WifiGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Guardian" Height="790" Width="720" MinHeight="720" MinWidth="660"
        Background="#F1F5F3" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#173F34" CornerRadius="12" Padding="20" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="WiFi Guardian" FontSize="25" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock Text="Vigila la conexión y recupera el punto de acceso móvil" Margin="0,5,0,0"
                               FontSize="13" Foreground="#D6E7E0" TextWrapping="Wrap" />
                </StackPanel>
                <Border Grid.Column="1" Width="46" Height="46" CornerRadius="10" Background="#286451" VerticalAlignment="Center">
                    <TextBlock Text="⌁" FontSize="34" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-5,0,0" />
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="CONFIGURACIÓN" FontSize="11" FontWeight="Bold" Foreground="#65736F" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*" />
                        <ColumnDefinition Width="1.5*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                        <TextBlock Text="IP de diagnóstico" Margin="0,0,0,5" FontWeight="SemiBold" />
                        <TextBox x:Name="IpBox" Text="1.1.1.1" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,0,12">
                        <TextBlock Text="Nombre de la Wi-Fi (SSID)" Margin="0,0,0,5" FontWeight="SemiBold" />
                        <TextBox x:Name="SsidBox" />
                    </StackPanel>

                    <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,0,0,12">
                        <TextBlock Text="Contraseña de la Wi-Fi" Margin="0,0,0,5" FontWeight="SemiBold" />
                        <PasswordBox x:Name="PasswordBox" />
                        <TextBlock Text="Se guarda cifrada para tu usuario de Windows." FontSize="11" Foreground="#65736F" Margin="0,5,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,12,8">
                        <TextBlock Text="Intervalo de revisión (segundos)" Margin="0,0,0,5" FontWeight="SemiBold" />
                        <TextBox x:Name="IntervalBox" Text="15" />
                    </StackPanel>
                    <CheckBox x:Name="StartupCheckBox" Grid.Row="2" Grid.Column="1" Content="Iniciar con Windows" VerticalAlignment="Center"
                              Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed" Margin="0,8,0,0" />

                    <TextBlock Grid.Row="3" Grid.ColumnSpan="2" Text="La IP es una prueba de alcance independiente. Internet se confirma con una petición HTTP real."
                               FontSize="11" Foreground="#65736F" TextWrapping="Wrap" Margin="0,5,0,0" />
                </Grid>
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button x:Name="StartButton" Content="Guardar y comenzar" Background="#216C54" Foreground="White" BorderThickness="0" Click="StartButton_Click" />
                    <Button x:Name="StopButton" Content="Detener" Click="StopButton_Click" IsEnabled="False" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="ESTADO ACTUAL" FontSize="11" FontWeight="Bold" Foreground="#65736F" Margin="0,0,0,12" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Wi-Fi" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBlock x:Name="WifiStatusText" Grid.Row="0" Grid.Column="1" Text="Esperando configuración" Margin="0,0,0,7" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="1" Text="IP de prueba" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBlock x:Name="IpStatusText" Grid.Row="1" Grid.Column="1" Text="Sin comprobar" Margin="0,0,0,7" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="2" Text="Internet" FontWeight="SemiBold" Margin="0,0,0,7" />
                    <TextBlock x:Name="InternetStatusText" Grid.Row="2" Grid.Column="1" Text="Sin comprobar" Margin="0,0,0,7" TextWrapping="Wrap" />
                    <TextBlock Grid.Row="3" Text="Punto de acceso" FontWeight="SemiBold" />
                    <TextBlock x:Name="HotspotStatusText" Grid.Row="3" Grid.Column="1" Text="Sin comprobar" TextWrapping="Wrap" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="REGISTRO DE ACTIVIDAD" FontSize="11" FontWeight="Bold" Foreground="#65736F" Margin="0,0,0,10" />
                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                         Background="#F7F9F8" BorderBrush="#E2E8E5" FontFamily="Consolas" FontSize="11"
                         Padding="10" />
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Text="WiFi Guardian · Windows 10 · revisión automática" FontSize="11" Foreground="#788780"
                   HorizontalAlignment="Center" />
    </Grid>
</Window>
