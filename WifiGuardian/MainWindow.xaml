<Window x:Class="WifiGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WiFi Guardian" Height="860" Width="1180" MinHeight="640" MinWidth="900"
        Background="{DynamicResource AppBackgroundBrush}" Foreground="{DynamicResource PrimaryTextBrush}"
        FontFamily="Segoe UI" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F3F6F5" />
        <SolidColorBrush x:Key="SidebarBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#172B25" />
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#66756F" />
        <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="InputForegroundBrush" Color="#20312B" />
        <SolidColorBrush x:Key="LogBackgroundBrush" Color="#F7F9F8" />
        <SolidColorBrush x:Key="LogBorderBrush" Color="#E2E8E0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#147D5A" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="#E4F4EC" />
        <SolidColorBrush x:Key="DangerBrush" Color="#B93838" />
        <SolidColorBrush x:Key="ControlBorderBrush" Color="#DCE5E0" />
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,3,0,3" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="SectionTitleStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="MetricValueStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="25" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="226" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Persistent navigation rail -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel LastChildFill="True" Margin="16,20,16,16">
                <StackPanel DockPanel.Dock="Top">
                    <Grid Margin="4,0,4,30">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" CornerRadius="13" Background="#173F34">
                            <TextBlock Text="WG" Foreground="White" FontSize="16" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,0,0">
                            <TextBlock Text="WiFi Guardian" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="NETWORK TOOLS" FontSize="9" Foreground="{DynamicResource SecondaryTextBrush}"
                                       Margin="0,3,0,0" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="ESPACIO DE TRABAJO" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="9,0,0,10" />
                    <Button x:Name="NavConnectionButton" Content="◉   Conexión" Style="{StaticResource NavButtonStyle}"
                            Click="NavConnectionButton_Click" />
                    <Button x:Name="NavStatsButton" Content="▥   Estadísticas" Style="{StaticResource NavButtonStyle}"
                            Click="NavStatsButton_Click" />
                    <Button x:Name="NavSettingsButton" Content="⚙   Configuración" Style="{StaticResource NavButtonStyle}"
                            Click="NavSettingsButton_Click" />
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="4,16,4,0">
                    <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,0,0,16" />
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="8" Height="8" Fill="#27AE78" Margin="0,0,8,0" />
                        <TextBlock Text="Monitor local" FontSize="12" FontWeight="SemiBold" />
                    </StackPanel>
                    <TextBlock Text="Los datos se guardan en este equipo." FontSize="11"
                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                               Margin="0,7,0,10" />
                    <TextBlock Text="WI-FI GUARDIAN  ·  1.0" FontSize="9"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Main work area -->
        <Grid Grid.Column="1" Margin="28,24,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="PageTitleText" Text="Conexión" FontSize="29" FontWeight="SemiBold" />
                    <TextBlock x:Name="PageSubtitleText" Text="Supervisión y recuperación de la conexión"
                               FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="20" Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                        Padding="12,8" Margin="0,0,10,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="RunStatusDot" Width="8" Height="8" Fill="#D97732" Margin="0,0,8,0" />
                        <TextBlock x:Name="RunStatusText" Text="DETENIDO" FontSize="11" FontWeight="Bold"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Button x:Name="ThemeButton" Grid.Column="2" Content="☾ Tema oscuro" Padding="13,10"
                        VerticalAlignment="Center" Click="ThemeButton_Click"
                        ToolTip="Alternar modo claro y oscuro" Margin="0" />
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- CONNECTION MODULE -->
                    <StackPanel x:Name="PageConnection" Visibility="Visible">
                        <Border Background="#173F34" CornerRadius="18" Padding="24" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Tu conexión, bajo control" Foreground="White"
                                               FontSize="22" FontWeight="SemiBold" />
                                    <TextBlock Text="Comprueba la red y recupera el punto de acceso cuando corresponda."
                                               Foreground="#D6E7E0" TextWrapping="Wrap" FontSize="13"
                                               Margin="0,7,12,0" />
                                    <TextBlock x:Name="ConnectionHeroText" Text="Esperando configuración"
                                               Foreground="#BEE8D3" FontSize="12" FontWeight="SemiBold"
                                               Margin="0,15,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="66" Height="66" CornerRadius="18"
                                        Background="#286451" VerticalAlignment="Center">
                                    <TextBlock Text="⌁" Foreground="White" FontSize="42"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Margin="0,-6,0,0" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="14" Padding="17" Margin="0,0,10,0"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="WI-FI" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="WifiStatusText" Text="Sin comprobar" FontSize="15"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Red objetivo" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="14" Padding="17" Margin="0,0,5,0"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="INTERNET" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="InternetStatusText" Text="Sin comprobar" FontSize="15"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Prueba HTTP" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}"
                                    CornerRadius="14" Padding="17" Margin="5,0,0,0"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="PUNTO DE ACCESO" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="HotspotStatusText" Text="Sin comprobar" FontSize="15"
                                               FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="Compartir conexión" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="20"
                                Margin="0,0,0,16" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="RED OBJETIVO" Style="{StaticResource SectionTitleStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="Nombre de la Wi-Fi (SSID)" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,0,0,6" />
                                        <TextBox x:Name="SsidBox" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,0,0">
                                        <TextBlock Text="Contraseña de la Wi-Fi" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,0,0,6" />
                                        <PasswordBox x:Name="PasswordBox" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="La contraseña se protege con DPAPI para tu usuario de Windows."
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,9,0,0" />
                                <WrapPanel Margin="0,18,0,0">
                                    <Button x:Name="StartButton" Content="Guardar y comenzar" Background="{DynamicResource AccentBrush}"
                                            Foreground="White" BorderThickness="0" Click="StartButton_Click" />
                                    <Button x:Name="StopButton" Content="Detener vigilancia" Click="StopButton_Click" IsEnabled="False" />
                                    <TextBlock x:Name="IpStatusText" Text="IP sin comprobar" FontSize="12"
                                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center"
                                               Margin="10,0,0,0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="20"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Actividad reciente" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Eventos de vigilancia y diagnóstico" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Ver estadísticas  →" Click="NavStatsButton_Click"
                                            Padding="12,8" Margin="0" />
                                </Grid>
                                <TextBox x:Name="LogBox" Grid.Row="1" IsReadOnly="True" AcceptsReturn="True"
                                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         Background="{DynamicResource LogBackgroundBrush}"
                                         BorderBrush="{DynamicResource LogBorderBrush}"
                                         Foreground="{DynamicResource InputForegroundBrush}"
                                         FontFamily="Consolas" FontSize="11" Padding="12"
                                         Height="190" Margin="0,14,0,0" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- STATISTICS MODULE -->
                    <StackPanel x:Name="PageStatistics" Visibility="Collapsed">
                        <TextBlock Text="Indicadores basados en las comprobaciones de WiFi Guardian."
                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,18" />
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14"
                                    Padding="20" Margin="0,0,10,0" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="DISPONIBILIDAD DE INTERNET" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="StatsAvailabilityText" Text="Sin datos" Style="{StaticResource MetricValueStyle}" />
                                    <TextBlock Text="Muestras con respuesta HTTP correcta" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14"
                                    Padding="20" Margin="0,0,5,0" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="LATENCIA RECIENTE" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="StatsLatencyText" Text="—" Style="{StaticResource MetricValueStyle}" />
                                    <TextBlock Text="Tiempo de respuesta ICMP" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14"
                                    Padding="20" Margin="5,0,0,0" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="MUESTRAS GUARDADAS" Style="{StaticResource SectionTitleStyle}" />
                                    <TextBlock x:Name="StatsSamplesText" Text="0" Style="{StaticResource MetricValueStyle}" />
                                    <TextBlock Text="Historial local acumulado" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="20"
                                Margin="0,0,0,16" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tendencia de latencia" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Últimas 40 mediciones con respuesta" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="ms" FontSize="11"
                                               Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" />
                                </Grid>
                                <Border Background="{DynamicResource LogBackgroundBrush}" CornerRadius="10" Padding="8">
                                    <Canvas x:Name="StatsChartCanvas" Height="220" SizeChanged="StatsChartCanvas_SizeChanged" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="20"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Últimas comprobaciones" FontSize="15" FontWeight="SemiBold" />
                                        <TextBlock Text="Registro de muestras guardadas en este equipo" FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,4,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="Borrar estadísticas" Click="ClearStatisticsButton_Click"
                                            Foreground="{DynamicResource DangerBrush}" Margin="0" />
                                </Grid>
                                <TextBlock x:Name="StatsHistoryText" Text="Todavía no hay mediciones. Inicia la vigilancia para comenzar a recopilar datos."
                                            TextWrapping="NoWrap" FontFamily="Consolas" FontSize="11"
                                            Padding="12" Background="{DynamicResource LogBackgroundBrush}"
                                            Foreground="{DynamicResource InputForegroundBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- SETTINGS MODULE -->
                    <StackPanel x:Name="PageSettings" Visibility="Collapsed">
                        <TextBlock Text="Ajusta el comportamiento de la vigilancia y la apariencia de la aplicación."
                                   FontSize="13" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,0,0,18" />
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="22"
                                Margin="0,0,0,16" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="DIAGNÓSTICO Y SUPERVISIÓN" Style="{StaticResource SectionTitleStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                                        <TextBlock Text="IP de diagnóstico" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                        <TextBox x:Name="IpBox" Text="1.1.1.1" />
                                        <TextBlock Text="Dirección usada para la prueba de latencia ICMP."
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Intervalo de revisión (segundos)" FontSize="12" FontWeight="SemiBold"
                                                   Margin="0,0,0,6" />
                                        <TextBox x:Name="IntervalBox" Text="15" />
                                        <TextBlock Text="Admite valores de 5 a 3600 segundos."
                                                   FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>
                                <CheckBox x:Name="StartupCheckBox" Content="Iniciar WiFi Guardian con Windows"
                                          Checked="StartupCheckBox_Changed" Unchecked="StartupCheckBox_Changed"
                                          Margin="0,18,0,5" />
                                <TextBlock Text="El inicio automático se configura para tu usuario actual."
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="22,0,0,0" />
                                <Button Content="Guardar parámetros" Click="SaveSettingsButton_Click"
                                        Background="{DynamicResource AccentBrush}" Foreground="White"
                                        BorderThickness="0" Margin="0,20,0,0" HorizontalAlignment="Left" />
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="22"
                                Margin="0,0,0,16" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="APARIENCIA" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Tema de la interfaz" FontSize="13" FontWeight="SemiBold" />
                                <TextBlock Text="Por defecto, se utiliza el tema configurado en Windows. Puedes cambiarlo aquí."
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,0,12" />
                                <WrapPanel>
                                    <Button x:Name="ThemeSystemButton" Content="Seguir a Windows" Click="ThemeSystemButton_Click" />
                                    <Button x:Name="ThemeLightButton" Content="Modo claro" Click="ThemeLightButton_Click" />
                                    <Button x:Name="ThemeDarkButton" Content="Modo oscuro" Click="ThemeDarkButton_Click" Margin="0" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="14" Padding="22"
                                Margin="0,0,0,16" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="MANTENIMIENTO" Style="{StaticResource SectionTitleStyle}" />
                                <TextBlock Text="Restablecer configuración" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock Text="Elimina la configuración local guardada y desactiva el inicio automático. No modifica las redes guardadas de Windows."
                                           FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                           Margin="0,6,0,14" />
                                <Button x:Name="ResetButton" Content="Restablecer datos de la aplicación"
                                        Click="ResetButton_Click" Foreground="{DynamicResource DangerBrush}"
                                        BorderBrush="{DynamicResource DangerBrush}" HorizontalAlignment="Left" Margin="0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
